{
    "name": "publish-report",
    "version": "1.0.0",
    "description": "extension to publish reports",
    "main": "index.js",
    "scripts": {
        "prettier": "prettier --config .prettierrc '**/*.ts' --write",
        "prebuild": "npx azde-scripts install",
        "build": "npx azde-scripts build",
        "package": "npx azde-scripts package",
        "clean": "rimraf ./dist",
        "create": "tfx extension create --output-path dist --overrides-file config/pdn.json --rev-version",
        "create:dev": "tfx extension create --output-path dist --overrides-file config/dev.json --rev-version",
        "create:qa": "tfx extension create --output-path dist --overrides-file config/qa.json --rev-version"
    },
    "keywords": [
        "azure",
        "devops",
        "pipelines",
        "politics"
    ],
    "author": "David Polania",
    "license": "ISC",
    "devDependencies": {
        "@types/node": "^20.8.7",
        "@types/q": "~1.5.8",
        "typescript": "^5.2.2",
        "tfx-cli": "^0.24.2",
        "prettier": "^3.10.1",
        "rimraf": "^5.0.5"
    }
}